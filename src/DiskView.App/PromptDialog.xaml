<Window x:Class="DiskView.App.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}">
    <Border Margin="14" Background="White" CornerRadius="10" BorderBrush="#E1E7F0" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.22" Color="#334155" />
        </Border.Effect>
        <StackPanel Margin="22,18,22,20">
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
            <TextBlock x:Name="MessageText" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                       TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBox x:Name="InputBox" Height="34" Margin="0,14,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Width="80" Height="32" IsCancel="True" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Width="92" Height="32"
                        Margin="8,0,0,0" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
