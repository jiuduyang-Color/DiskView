<Window x:Class="DiskView.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:DiskView.App"
        xmlns:core="clr-namespace:DiskView.Core;assembly=DiskView.Core"
        Title="{app:Tr AppTitle}"
        Width="1300"
        Height="840"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        FontFamily="{StaticResource AppFont}"
        Icon="Assets/app.ico"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ContextMenu x:Key="FolderMenu" x:Shared="False" FontFamily="{StaticResource AppFont}">
            <MenuItem Header="{app:Tr Open}" InputGestureText="Enter" Click="Open_Click" />
            <MenuItem Header="{app:Tr OpenLocation}" Click="OpenLocation_Click" />
            <MenuItem Header="{app:Tr CopyPath}" Click="CopyPath_Click" />
            <Separator />
            <MenuItem Header="{app:Tr Copy}" InputGestureText="Ctrl+C" Click="Copy_Click" />
            <MenuItem Header="{app:Tr Cut}" InputGestureText="Ctrl+X" Click="Cut_Click" />
            <MenuItem Header="{app:Tr Paste}" InputGestureText="Ctrl+V" Click="Paste_Click" />
            <Separator />
            <MenuItem Header="{app:Tr NewFolder}" Click="NewFolder_Click" />
            <MenuItem Header="{app:Tr Rename}" InputGestureText="F2" Click="Rename_Click" />
            <MenuItem Header="{app:Tr Delete}" InputGestureText="Delete" Click="Delete_Click" />
            <MenuItem Header="{app:Tr DeletePermanent}" InputGestureText="Shift+Delete" Click="DeletePermanent_Click" />
            <Separator />
            <MenuItem Header="{app:Tr Properties}" Click="Properties_Click" />
            <MenuItem Header="{app:Tr Refresh}" InputGestureText="F5" Click="RefreshFolder_Click" />
        </ContextMenu>

        <ContextMenu x:Key="FileMenu" x:Shared="False" FontFamily="{StaticResource AppFont}">
            <MenuItem Header="{app:Tr Open}" InputGestureText="Enter" Click="Open_Click" />
            <MenuItem Header="{app:Tr OpenLocation}" Click="OpenLocation_Click" />
            <MenuItem Header="{app:Tr CopyPath}" Click="CopyPath_Click" />
            <Separator />
            <MenuItem Header="{app:Tr Copy}" InputGestureText="Ctrl+C" Click="Copy_Click" />
            <MenuItem Header="{app:Tr Cut}" InputGestureText="Ctrl+X" Click="Cut_Click" />
            <MenuItem Header="{app:Tr Paste}" InputGestureText="Ctrl+V" Click="Paste_Click" />
            <Separator />
            <MenuItem Header="{app:Tr Rename}" InputGestureText="F2" Click="Rename_Click" />
            <MenuItem Header="{app:Tr Delete}" InputGestureText="Delete" Click="Delete_Click" />
            <MenuItem Header="{app:Tr DeletePermanent}" InputGestureText="Shift+Delete" Click="DeletePermanent_Click" />
            <Separator />
            <MenuItem Header="{app:Tr SelectAll}" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
            <MenuItem Header="{app:Tr Properties}" Click="Properties_Click" />
            <MenuItem Header="{app:Tr Refresh}" InputGestureText="F5" Click="RefreshFolder_Click" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/app.ico" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{app:Tr AppTitle}" FontSize="14.5" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="{app:Tr AppSubtitle}" FontSize="10.5" Margin="0,1,0,0"
                                   Foreground="{StaticResource TextTertiary}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                    <ComboBox x:Name="DriveCombo" Width="272" DisplayMemberPath="Display"
                              SelectionChanged="DriveCombo_SelectionChanged" />
                    <Button Content="{app:Tr Scan}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                            Click="ScanButton_Click" />
                    <Button x:Name="RefreshButton" Content="&#xE72C;" Style="{StaticResource IconButton}"
                            Margin="6,0,0,0" ToolTip="{app:Tr Rescan}" Click="RefreshButton_Click" />
                </StackPanel>

                <Border Grid.Column="2" Width="238" Height="32" Background="White"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 Padding="0" FontSize="12" TextChanged="SearchBox_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="{app:Tr SearchPlaceholder}"
                                   Foreground="{StaticResource TextTertiary}" FontSize="11.5" Margin="1,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 路径栏 -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="UpButton" Style="{StaticResource GhostButton}" Height="26" Padding="9,0"
                        IsEnabled="False" Click="UpButton_Click" ToolTip="{app:Tr Up}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{app:Tr Up}" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="1" Background="#F7F9FC" CornerRadius="5" Margin="10,7" Padding="10,0">
                    <TextBlock x:Name="PathText" Text="{app:Tr EmptyTitle}" FontFamily="{StaticResource MonoFont}"
                               FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Border>

                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28"
                        ToolTip="{app:Tr CopyPath}" Click="CopyPathButton_Click">
                    <Grid Width="13" Height="13">
                        <Rectangle Width="8.5" Height="8.5" Stroke="#68748A" StrokeThickness="1"
                                   RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Rectangle Width="8.5" Height="8.5" Stroke="#68748A" StrokeThickness="1" Fill="White"
                                   RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- 主内容 -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="220" MaxWidth="620" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧目录树 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid>
                            <TextBlock Text="{app:Tr Folders}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TreeSummary" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="10.5" Foreground="{StaticResource TextTertiary}" />
                        </Grid>
                    </Border>
                    <TreeView x:Name="FolderTree" Grid.Row="1" Margin="6,4,2,4"
                              ItemContainerStyle="{StaticResource FolderTreeItem}"
                              ContextMenu="{StaticResource FolderMenu}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type core:FileNode}" ItemsSource="{Binding SubDirectories}">
                                <Grid Height="24" ToolTip="{Binding FullPath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Path Fill="#7FA8E8" Data="M0,2.5 H4.2 L5.4,4 H12 V10.5 H0 Z" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Size, Converter={StaticResource SizeConverter}}"
                                               FontSize="10.5" Foreground="{StaticResource TextTertiary}"
                                               VerticalAlignment="Center" Margin="6,0,8,0" />
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <ProgressBar Style="{StaticResource MiniBar}" Height="3" VerticalAlignment="Center">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource PercentConverter}" Mode="OneWay">
                                                    <Binding Path="Size" />
                                                    <Binding Path="Parent.Size" />
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </Grid>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" />

            <!-- 右侧：树图 + 文件列表 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="304" MinHeight="150" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{app:Tr TreemapTitle}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TreemapFolderName" FontSize="11.5" Margin="8,0,0,0"
                                               Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="10.5" />
                                            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
                                            <Setter Property="Margin" Value="5,0,12,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Width" Value="8" />
                                            <Setter Property="Height" Value="8" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <Ellipse Fill="#D3E2FB" />
                                    <TextBlock Text="{app:Tr LegendFolder}" />
                                    <Ellipse Fill="#FFD6C4" />
                                    <TextBlock Text="{app:Tr LegendVideo}" />
                                    <Ellipse Fill="#CDEDDA" />
                                    <TextBlock Text="{app:Tr LegendImage}" />
                                    <Ellipse Fill="#FFE8BA" />
                                    <TextBlock Text="{app:Tr LegendArchive}" />
                                    <Ellipse Fill="#D2E6FA" />
                                    <TextBlock Text="{app:Tr LegendDocument}" />
                                    <Ellipse Fill="#E6EAF1" />
                                    <TextBlock Text="{app:Tr LegendOther}" Margin="5,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <app:TreemapView x:Name="Treemap" Grid.Row="1" Margin="4"
                                         NavigateRequested="Treemap_NavigateRequested"
                                         FileSelected="Treemap_FileSelected"
                                         FileActivated="Treemap_FileActivated"
                                         NodeRightClicked="Treemap_NodeRightClicked" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Style="{StaticResource RowSplitter}" />

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid>
                                <TextBlock Text="{app:Tr FileListTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FileHeaderInfo" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="10.5" Foreground="{StaticResource TextTertiary}" />
                            </Grid>
                        </Border>

                        <DataGrid x:Name="FileGrid" Grid.Row="1" ContextMenu="{StaticResource FileMenu}"
                                  PreviewMouseRightButtonDown="FileGrid_PreviewMouseRightButtonDown"
                                  MouseDoubleClick="FileGrid_MouseDoubleClick"
                                  SelectionChanged="FileGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{app:Tr Name}" Width="*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox x:Name="FolderIcon" Width="11" Height="11" Margin="0,0,5,0"
                                                         VerticalAlignment="Center">
                                                    <Path Fill="#7FA8E8" Data="M0,2.5 H4.2 L5.4,4 H12 V10.5 H0 Z" />
                                                </Viewbox>
                                                <Border x:Name="CategoryDot" Width="8" Height="8" CornerRadius="2"
                                                        Background="{Binding CategoryBrush}" Visibility="Collapsed"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                                    <Setter TargetName="FolderIcon" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="CategoryDot" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="{app:Tr Size}" Binding="{Binding SizeText}" SortMemberPath="Size" Width="106">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="{app:Tr Percent}" Binding="{Binding PercentText}" SortMemberPath="Percent" Width="84">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="{app:Tr Modified}" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="146">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11.5" />
                                            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="{app:Tr Type}" Binding="{Binding TypeText}" SortMemberPath="TypeText" Width="94">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11.5" />
                                            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyState" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="Assets/app.ico" Width="60" Height="60" Opacity="0.85"
                           HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{app:Tr EmptyTitle}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="{app:Tr EmptyHint}" FontSize="12" Foreground="{StaticResource TextTertiary}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <!-- 扫描进度 -->
                <Border x:Name="ScanOverlay" Grid.RowSpan="3" Background="#F9FFFFFF" Visibility="Collapsed">
                    <StackPanel Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ScanTitle" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ScanNote" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                   Margin="0,6,0,0" HorizontalAlignment="Center" />
                        <ProgressBar Style="{StaticResource ScanBar}" IsIndeterminate="True" Height="4" Margin="0,16,0,0" />
                        <TextBlock x:Name="ScanStats" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,14,0,0" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ScanCurrent" FontSize="10.5" Foreground="{StaticResource TextTertiary}"
                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                   MaxWidth="440" />
                        <Button Content="{app:Tr Cancel}" Style="{StaticResource GhostButton}" Width="92"
                                Margin="0,18,0,0" HorizontalAlignment="Center" Click="CancelScan_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="StatusLeft" FontSize="10.5" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusRight" HorizontalAlignment="Right" FontSize="10.5"
                           Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
