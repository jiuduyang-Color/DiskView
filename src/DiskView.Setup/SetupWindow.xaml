<Window x:Class="DiskView.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:DiskView.Setup"
        Title="{app:Tr SetupTitle}"
        Icon="Assets/app.ico"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI, Segoe UI, Arial"
        Background="#FFFFFF"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#2F6BE8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2559C9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1D49A8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#B9C6DE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#3A4658" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D8DFEA" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F2F6FD" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#B9C6DE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1B2431" />
            <Setter Property="BorderBrush" Value="#D8DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#2F6BE8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#3A4658" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Foreground" Value="#2F6BE8" />
            <Setter Property="Background" Value="#E6EFFE" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="Assets/app.ico" Width="44" Height="44" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{app:Tr SetupHeading}" FontSize="19" FontWeight="Bold" Foreground="#1B2431" />
                <TextBlock Text="{app:Tr SetupSubtitle}" FontSize="12" Foreground="#68748A" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 主体 -->
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <Border Height="1" Background="#E3E8F0" />

            <StackPanel x:Name="InstallPanel" Margin="0,18,0,0">
                <TextBlock Text="{app:Tr InstallPath}" FontSize="12" Foreground="#68748A" />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" />
                    <Button Grid.Column="1" Content="{app:Tr Browse}" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="Browse_Click" />
                </Grid>

                <CheckBox x:Name="DesktopCheck" Content="{app:Tr DesktopShortcut}" IsChecked="True" Margin="0,16,0,0" />

                <TextBlock Text="{app:Tr PerUserNote}" FontSize="11.5" Foreground="#9AA5B5"
                           Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="SizeNote" FontSize="11.5" Foreground="#9AA5B5" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="{app:Tr Cancel}" Style="{StaticResource GhostButton}" Width="92"
                            Click="Close_Click" />
                    <Button x:Name="InstallButton" Content="{app:Tr Install}" Style="{StaticResource PrimaryButton}"
                            Width="112" Margin="10,0,0,0" Click="Install_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="DonePanel" Visibility="Collapsed" Margin="0,22,0,0">
                <TextBlock Text="{app:Tr InstallDone}" FontSize="16" FontWeight="SemiBold" Foreground="#1B2431" />
                <TextBlock Text="{app:Tr InstallDoneHint}" FontSize="12" Foreground="#68748A"
                           Margin="0,6,0,0" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="RunButton" Content="{app:Tr RunApp}" Style="{StaticResource GhostButton}"
                            Width="112" Click="Run_Click" />
                    <Button Content="{app:Tr Finish}" Style="{StaticResource PrimaryButton}"
                            Width="96" Margin="10,0,0,0" Click="Close_Click" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="#68748A" Margin="0,12,0,0"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,7,0,0" />
        </StackPanel>
    </Grid>
</Window>
